{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Flarebot",
  "version": "0.1.0",
  "identifier": "com.flarebot.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:8787",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "Flarebot",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
