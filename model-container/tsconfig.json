{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "pi-claude-bridge/src/index.ts": ["./types/bridge-extension.d.ts"],
      "pi-claude-bridge/src/transcript.ts": ["./types/bridge-transcript.d.ts"]
    }
  },
  "include": ["server.ts"]
}
