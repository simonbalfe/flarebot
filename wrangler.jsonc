{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flarebot",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "DEFAULT_MODEL": "anthropic/claude-sonnet-5.5",
    "ROUTER_MODEL": "anthropic/claude-haiku-5.5"
  },
  "send_email": [{ "name": "EMAIL" }],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "flarebot", "remote": true }],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "flarebot-auth",
      "database_id": "f8aa6547-b8bf-4664-addd-dfbe9b17c1f5",
      "migrations_dir": "migrations"
    }
  ],
  "containers": [
    {
      "class_name": "Computer",
      "image": "./computer/Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "USER", "class_name": "User" },
      { "name": "BOT", "class_name": "Bot" },
      { "name": "COMPUTER", "class_name": "Computer" },
      { "name": "GROUP", "class_name": "Group" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["User", "Bot", "Computer"] },
    { "tag": "v2", "new_sqlite_classes": ["Group"] }
  ]
}
